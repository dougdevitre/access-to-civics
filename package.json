{
  "name": "access-to-civics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Charter — a civic education game built on all 50 U.S. state constitutions",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "node --experimental-strip-types src/ingest/cli.ts",
    "gates": "node scripts/check-clause-refs.mjs && node scripts/check-quote-integrity.mjs && node scripts/check-sensitivity.mjs && node scripts/check-gloss-freeze.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.665.0",
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/lib-dynamodb": "^3.665.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
